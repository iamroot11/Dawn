# ============================
.env
.env.*
!.env.example
*.key
secrets.json
 
# ============================
# DAWN's actual data — never committed
# (personal question logs, sensitive; schema/code is public, data isn't)
# ============================
*.db
*.sqlite
*.sqlite3
/data/
/instance/
 
# Uploaded photos (doubt-solving working, question papers) — personal, not code
/uploads/
/photos/
/media/
 
